#!/bin/bash
# smplOS Emergency Screen Recovery
#
# Blind-typable via `Ctrl+Alt+D` binding in emergency.conf. Also fired
# automatically by hypridle's `on-resume` on the DPMS listener.
#
# WHAT THIS DOES (post-Hyprland-0.56.0):
#   1. `hl.dsp.dpms({state='off'})` then `on` — forces a CRTC power cycle.
#   2. `hyprctl reload` — re-reads config, rebuilds monitor state.
#   3. Second `dpms on` — belt-and-suspenders if the first was a no-op.
#
# HISTORY (why this is now much smaller):
#   Older revisions had a "step 4" that rewrote ~/.config/hypr/monitors.conf
#   with every monitor set to `disable`, ran `hyprctl reload`, then restored
#   the original file. That was our workaround for the nvidia+Hyprland
#   post-DPMS-wake bug on 0.55.x where DPMS toggles silently no-op'd.
#
#   Two things went badly wrong with step 4:
#     * Race condition: two concurrent invocations (Ctrl+Alt+D pressed while
#       hypridle's on-resume was already running) both backed up "current"
#       state, but B's backup captured A's mid-swap DISABLED state. Result:
#       monitors.conf permanently ended up disabled. Next boot: black screen.
#     * Interrupt window: if the script died between "write disabled" and
#       "restore original" (killed, session end, reboot during recovery),
#       monitors.conf was left in the disabled state. Next boot: black screen.
#   Both of those exact failures burned the user on 2026-07-24/25.
#
#   Hyprland 0.56.0 shipped the upstream fix for the underlying DPMS bug
#   (compositor: fix monitor re-enabling on hotplug when dpms is off,
#   PR #14818). Steps 1-3 alone should now bring the panel back reliably.
#   If they don't, we'll add a SAFER escalation (with proper trap-based
#   restoration and a `flock` lock) — but not until we know we need it.
#
# LOCKFILE:
#   flock still protects steps 1-3 from concurrent runs, because two
#   invocations racing through `hyprctl dispatch dpms off/on` back-to-back
#   can leave the CRTC in a weird state.

set +e

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/smplos"
mkdir -p "$LOG_DIR" 2>/dev/null
LOG="$LOG_DIR/screen-recover.log"
LOCK="$LOG_DIR/screen-recover.lock"
if [[ -f "$LOG" ]] && [[ $(stat -c%s "$LOG" 2>/dev/null || echo 0) -gt 204800 ]]; then
    tail -c 102400 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S.%3N')" "$*" >> "$LOG"; }

# Take a non-blocking lock. If another screen-recover is running, skip —
# no point piling up DPMS toggles (and no point risking a race).
exec 9>"$LOCK"
if ! flock -n 9; then
    log "=== screen-recover skipped (pid $$): another instance already running ==="
    exit 0
fi

log "=== screen-recover invoked (pid $$) ==="

if ! command -v hyprctl &>/dev/null; then
    log "hyprctl not in PATH — nothing to do"
    exit 1
fi

# Step 1: DPMS off -> on cycle via Lua dispatcher
log "step 1: dpms off -> on (Lua)"
hyprctl dispatch "hl.dsp.dpms({state='off'})" 2>>"$LOG"
log "  dpms off -> $?"
sleep 0.5
hyprctl dispatch "hl.dsp.dpms({state='on'})" 2>>"$LOG"
log "  dpms on  -> $?"
sleep 0.3

# Step 2: reload compositor config (rebuilds monitor state)
log "step 2: hyprctl reload"
hyprctl reload 2>>"$LOG"
log "  reload -> $?"
sleep 0.3

# Step 3: belt-and-suspenders second DPMS on
log "step 3: dpms on (retry)"
hyprctl dispatch "hl.dsp.dpms({state='on'})" 2>>"$LOG"
log "  dpms on -> $?"

# Nudge the user with a notification so they know a recovery ran (and, if
# the screen is back, they see it). Non-fatal.
notify-send "Screen Recovery" "Ran DPMS off/on + reload cycle. Check ~/.cache/smplos/screen-recover.log for details." 2>/dev/null || true

log "=== screen-recover done ==="
exit 0
